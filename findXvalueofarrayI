#include <iostream>
#include <vector>
using namespace std;

class Solution {
public:
    vector<long long> resultArray(vector<int>& nums, int k) {
        vector<long long> result(k, 0);
        vector<long long> dp(k, 0);

        for (int num : nums) {
            vector<long long> newDp(k, 0);

            int current = num % k;

            newDp[current]++;

            for (int r = 0; r < k; r++) {
                int newRemainder = (r * current) % k;
                newDp[newRemainder] += dp[r];
            }

            dp = newDp;

            for (int r = 0; r < k; r++) {
                result[r] += dp[r];
            }
        }

        return result;
    }
};

int main() {
    Solution obj;

    vector<int> nums = {1, 2, 3, 4, 5};
    int k = 3;

    vector<long long> result = obj.resultArray(nums, k);

    cout << "[";

    for (int i = 0; i < result.size(); i++) {
        cout << result[i];

        if (i != result.size() - 1) {
            cout << ",";
        }
    }

    cout << "]" << endl;

    return 0;
}